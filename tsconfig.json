{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "shared/*"
      ],
      "@server/*": [
        "server/*"
      ]
    },
    "types": [
      "bun-types"
    ],
    "noUnusedParameters": true
  },
  "include": [
    "shared/**/*",
    "server/**/*",
    "ui/src/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "ui/dist"
  ]
}
